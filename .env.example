# PostgreSQL connection string. Local Docker Compose uses the value below.
DATABASE_URL=postgres://frimz:frimz@localhost:5436/frimz

# Auth.js session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public site URL used for Open Graph metadata. Set this in production.
AUTH_URL=http://localhost:3000

# Server-only Cursor model access. Never expose this to the browser.
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# Server-only Walrus Memory delegate credentials from https://staging.memory.walrus.xyz
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer-staging.memory.walrus.xyz
